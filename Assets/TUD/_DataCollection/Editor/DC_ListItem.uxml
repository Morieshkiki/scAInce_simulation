<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:GroupBox style="align-items: center; flex-direction: row; justify-content: space-between; height: 30px; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-top: 0; padding-bottom: 0;">
        <ui:VisualElement name="Left" style="align-items: center; flex-direction: row; height: 100%; flex-shrink: 0; flex-grow: 1;">
            <ui:Toggle />
            <ui:VisualElement name="space" style="height: 100%; width: 10px;" />
            <ui:Label text="Some Data Collector" display-tooltip-when-elided="true" />
            <ui:VisualElement name="space" style="height: 100%; width: 10px;" />
        </ui:VisualElement>
        <ui:VisualElement name="Right" style="align-items: center; flex-direction: row; height: 100%; justify-content: flex-end; flex-grow: 0; flex-shrink: 0; background-color: rgba(0, 0, 0, 0.28); min-width: initial;">
            <ui:Button text="view" display-tooltip-when-elided="true" />
            <ui:Button text="REC" display-tooltip-when-elided="true" />
        </ui:VisualElement>
    </ui:GroupBox>
</ui:UXML>
